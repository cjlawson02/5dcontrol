namespace Control;

enum ControlType:byte {
  NONE = 0,
  FOCUS = 1,
  CAPTURE = 2,
  QUERY_STATUS = 3
}

enum MessageType:byte {
  UNKNOWN = 0,
  COMMAND = 1,
  STATUS = 2,
  IMAGE_READY = 3
}

table Command {
  type:ControlType;
}

table Status {
  camera_connected:bool;
  battery_level:uint8;
}

// Paths are HTTP paths on :8080 (e.g. /captures/{id}/full.jpg).
// Clients prepend http://{serverIp}:8080.
table ImageReady {
  image_id:string;
  thumb_path:string;
  full_path:string;
}

table Message {
  message_type:MessageType;
  command:Command;
  status:Status;
  image_ready:ImageReady;
}

root_type Message;
